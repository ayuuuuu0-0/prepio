# ==============================================================================
# Prepio Environment Configuration Template
# For local dev: copy this to .env (defaults work out of the box)
# For AWS / Prod: copy this to .env and set strong secrets below
# ==============================================================================

# PostgreSQL
POSTGRES_USER=prepio
POSTGRES_PASSWORD=prepio_change_in_production
POSTGRES_DB=prepio
DATABASE_URL=postgres://prepio:prepio@localhost:5432/prepio?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Event bus (set DEV_SYNC_EVENTS=true to run without Kafka, saving ~400MB RAM)
KAFKA_BROKERS=localhost:9092
DEV_SYNC_EVENTS=true

# Allowed CORS Origins (Comma-separated. In production, add your Vercel URL)
# Example for Prod: https://prepio-ai.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://prepio-ai.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Security / JWT Secret (MUST be at least 32 characters in production)
JWT_SECRET=prepio-super-secure-secret-key-must-be-32-chars-min

# Service ports (internal)
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
QUESTION_SERVICE_PORT=8082
STREAK_SERVICE_PORT=8083
PROGRESS_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# Internal service URLs
USER_SERVICE_URL=http://localhost:8081
QUESTION_SERVICE_URL=http://localhost:8082
STREAK_SERVICE_URL=http://localhost:8083
PROGRESS_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085

# Evaluation engine — Stage 3 (LLM) is optional.
# Leave blank to run Stages 1+2 only (structural evaluation, no API cost).
# Set to a valid Gemini API key to enable Stage 3 semantic grading.
GEMINI_API_KEY=
